# ==============================================================================
# CRIMINTEL - Environment Variables Configuration
# Problem Statement ID: SIH26189 - Ministry of Home Affairs (MHA) - NCRB
# ==============================================================================

# Supabase Backend Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-keep-private

# AI / NLP Provider Abstraction
# Options: 'deterministic_nlp' (built-in zero-key fallback), 'gemini', 'openai'
AI_PROVIDER=deterministic_nlp
AI_API_KEY=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_MODEL=

# Storage Buckets
SUPABASE_EVIDENCE_BUCKET=investigation-evidence
SUPABASE_REPORTS_BUCKET=investigation-reports

# Optional Geo Map Provider (e.g., 'osm', 'mapbox')
NEXT_PUBLIC_MAP_PROVIDER=osm
MAP_API_KEY=

# Application Mode
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
